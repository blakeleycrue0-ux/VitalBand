# ============================================================================
# VitalBand — Environment Variables
# Copy this file to .env for local development (Vite) and set the same
# names in Netlify → Site configuration → Environment variables for deploys.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Anything WITHOUT that prefix is server-only and is read exclusively by
# Netlify Functions (netlify/functions/**). Never rename a server-only
# variable to start with VITE_ — that would ship it to the browser.
# ============================================================================


# ----------------------------------------------------------------------------
# PUBLIC VARIABLES (safe to expose in frontend bundle — read by browser code)
# ----------------------------------------------------------------------------

# Supabase project URL and anon (public) key. The anon key is designed to be
# public — Row Level Security in supabase/migrations governs what it can
# read/write. It must NEVER be able to read customers/orders (see RLS policies).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Live notifications widget (see src/js/notifications.js)
# NOTIFICATIONS_MODE=demo uses simulated, clearly-labeled fake activity.
# NOTIFICATIONS_MODE=live reads only real rows from the notification_events table.
VITE_NOTIFICATIONS_ENABLED=true
VITE_NOTIFICATIONS_MODE=demo

# Stripe publishable key (safe to expose — used only to redirect to Stripe Checkout)
VITE_STRIPE_PUBLISHABLE_KEY=


# ----------------------------------------------------------------------------
# PRIVATE SERVER VARIABLES (Netlify Functions ONLY — never read by frontend code,
# never prefixed with VITE_, never bundled by Vite)
# ----------------------------------------------------------------------------

# Supabase service role key — bypasses RLS. Used only inside netlify/functions
# to write orders/customers and to read private data for order-lookup.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret key + webhook signing secret (see netlify/functions/create-checkout.js
# and netlify/functions/stripe-webhook.js)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CJdropshipping API v2 credentials (see netlify/functions/utils/cjClient.js).
# Obtain these from your CJ account: Personal Center → API → Get API Key.
# CJ_ACCESS_TOKEN is fetched and cached automatically by cjClient.js using
# CJ_EMAIL + CJ_API_KEY — you do not need to hardcode an access token.
CJ_EMAIL=
CJ_API_KEY=

# Base currency / storefront config used by functions that compute totals
SITE_CURRENCY=EUR

# Shared secret required in the `x-internal-key` header to call the cj-*.js
# admin/back-office endpoints (netlify/functions/cj-product.js, cj-inventory.js,
# cj-create-order.js, cj-order-status.js, cj-tracking.js). These are not called
# by the storefront itself (see netlify/functions/utils/internalAuth.js) — set
# this to a long random value and keep it private. Generate one with:
#   openssl rand -hex 32
INTERNAL_FUNCTIONS_KEY=
