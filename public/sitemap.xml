<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static starter sitemap — replace https://your-domain.example with your real
  Netlify/custom domain once deployed. As more products are added to Supabase,
  this should become generated at build time (e.g. a small Node script run
  before `vite build` that queries the `products` table for active slugs and
  writes this file), rather than maintained by hand.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://your-domain.example/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://your-domain.example/product.html?slug=smart-bracelet</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
